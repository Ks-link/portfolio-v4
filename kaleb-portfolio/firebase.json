{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "kaleblink.com",
      "kaleblink-portfolio-v4.web.app",
      "kaleblink-portfolio-v4.firebaseapp.com"
    ],
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "nam5"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
